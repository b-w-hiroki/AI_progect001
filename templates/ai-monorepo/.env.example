# このファイルをコピーして .env を作る:  cp .env.example .env
#
# ルール:
#   - .env は絶対にコミットしない（.gitignore 済み）
#   - 新しい環境変数を足したら、必ずこのファイルにもキーだけ追記する
#   - 値の例はダミーにする。実際のキーをここに書かない

# --- AWS ---
AWS_REGION=ap-northeast-1

# --- Amazon Bedrock ---
# 認証はIAMロール経由なのでAPIキーは不要
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5

# --- アプリケーション ---
LOG_LEVEL=info
